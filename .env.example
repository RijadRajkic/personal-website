# Contact form email delivery (Resend — https://resend.com)
# Without these, the contact form still works in dev: it logs to the server console
# and returns a success response, so the UI can be exercised without a live email service.

# Get a key from https://resend.com/api-keys
RESEND_API_KEY=

# From address used by Resend. Until you verify your domain, use Resend's
# testing sender "onboarding@resend.dev" — note that it can only deliver to
# the email address you registered with Resend.
RESEND_FROM_EMAIL=onboarding@resend.dev

# Where contact form messages get delivered.
CONTACT_TO_EMAIL=rijadrajkic@gmail.com

# Notion CMS — powers /projects and /blog. Without these, both pages fall back to
# the hardcoded content baked into the repo, so the site still builds and runs.

# Integration token from https://www.notion.so/my-integrations (starts with "secret_" / "ntn_").
NOTION_TOKEN=secret_xxx

# Data-source (database) ID for the Projects database.
NOTION_DB_PROJECTS=<projects-database-id>

# Data-source (database) ID for the Blog Posts database.
NOTION_DB_BLOGPOSTS=<blog-posts-database-id>
